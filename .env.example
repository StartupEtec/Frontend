# URL base de la API del backend (sin trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# URL pública del WebSocket del backend (para mensajería en tiempo real)
# En desarrollo local: ws://localhost:3000
# Con túnel cloudflared: wss://<tunel-backend>.trycloudflare.com
EXPO_PUBLIC_WS_URL=ws://localhost:3000
