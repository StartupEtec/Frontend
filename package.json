{
  "name": "startup-frontend",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "EXPO_NO_DOCTOR=1 expo start",
    "start:tunnel": "EXPO_NO_DOCTOR=1 expo start --tunnel",
    "start:frontend-tunnel": "./scripts/start-frontend-tunnel.sh",
    "android": "EXPO_NO_DOCTOR=1 expo start --android",
    "ios": "EXPO_NO_DOCTOR=1 expo start --ios",
    "web": "EXPO_NO_DOCTOR=1 expo start --web",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "^57.0.0",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.17",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config-plugins": "^57.0.9",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": ["@expo/config-plugins"]
    }
  },
  "private": true
}
