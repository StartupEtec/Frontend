{
  "name": "startup-frontend",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "EXPO_NO_DOCTOR=1 expo start",
    "start:tunnel": "EXPO_NO_DOCTOR=1 expo start --tunnel",
    "start:frontend-tunnel": "./scripts/start-frontend-tunnel.sh",
    "android": "EXPO_NO_DOCTOR=1 expo start --android",
    "ios": "EXPO_NO_DOCTOR=1 expo start --ios",
    "web": "EXPO_NO_DOCTOR=1 expo start --web",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.22",
    "expo-camera": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config-plugins": "~58.0.11",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@expo/config-plugins"
      ]
    }
  },
  "private": true
}
