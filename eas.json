{
  "cli": {
    "version": ">= 27.11.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.laborin.app/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://app.laborin.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.laborin.app/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://app.laborin.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
